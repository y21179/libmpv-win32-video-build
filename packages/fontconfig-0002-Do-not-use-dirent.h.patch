From 4d9467292e899ffb0f2972b36a78777dbae5f920 Mon Sep 17 00:00:00 2001
From: Zhong Lufan <lufanzhong@gmail.com>
Date: Mon, 2 Nov 2026 12:13:36 +0800
Subject: [PATCH 2/2] Do not use dirent.h

Because this causes some quirks on some partitions on Windows.
---
 meson.build | 1 -
 1 file changed, 1 deletion(-)

diff --git a/meson.build b/meson.build
index bbfc5237..768e6f67 100644
--- a/meson.build
+++ b/meson.build
@@ -126,7 +126,6 @@ python3 = import('python').find_installation()
 pytest = find_program('pytest', required: false)
 
 check_headers = [
-  ['dirent.h'],
   ['dlfcn.h'],
   ['fcntl.h'],
   ['inttypes.h'],
-- 
2.52.0.windows.1

